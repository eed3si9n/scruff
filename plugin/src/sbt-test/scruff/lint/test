# `scruff` passes its arguments to the CLI, so `scruff check` lints. It runs
# once, on the whole build, though the root aggregates sub.
> resetRuns
> scruff check
> checkRuns 1

# `null` breaks rule S004, so the check fails.
$ copy-file null-B.txt src/main/scala/B.scala
-> scruff check
-> scruff check --output-format concise src

$ delete src/main/scala/B.scala
> scruff check
> scruff format --check src
