def f =
  val x = 1
  if x > 0 then
    c0()
    c1()
    c2()
    c3()
    c4()
    c5()
    c6()
    c7()
    c8()
    c9()
    c10()
    c11()
    c12()
    c13()
    c14()
    c15()
    c16()
    c17()
    c18()
    c19()
  else d()
  if x > 1 then a()
  else
    e0()
    e1()
    e2()
    e3()
    e4()
    e5()
    e6()
    e7()
    e8()
    e9()
    e10()
    e11()
    e12()
    e13()
    e14()
    e15()
    e16()
    e17()
    e18()
    e19()
  end if
  x
end f

<<< a short statement loses its marker
object A:
  def f =
    a
    b
  end f

  def g = 1
end A
>>>
object A:
  def f =
    a
    b

  def g = 1

