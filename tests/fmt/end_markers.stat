<<< an else if chain gets one marker, which tree-sitter-scala puts on its last if
object O:
  def k(x: Int): String =
    val f = 1
    if a then "p"
    else if b then
      if c then "q"
      else "r"
    else if d0 then "s"
    else if d1 then "s"
    else if d2 then "s"
    else if d3 then "s"
    else if d4 then "s"
    else if d5 then "s"
    else if d6 then "s"
    else if d7 then "s"
    else if d8 then "s"
    else if d9 then "s"
    else if d10 then "s"
    else if d11 then "s"
    else if d12 then "s"
    else if d13 then "s"
    else if d14 then "s"
    else if d15 then "s"
    else if d16 then "s"
    else if d17 then "s"
    else if d18 then "s"
    else if d19 then "s"
    else ""
  def z = 1
>>>
object O:
  def k(x: Int): String =
    val f = 1
    if a then "p"
    else if b then
      if c then "q"
      else "r"
    else if d0 then "s"
    else if d1 then "s"
    else if d2 then "s"
    else if d3 then "s"
    else if d4 then "s"
    else if d5 then "s"
    else if d6 then "s"
    else if d7 then "s"
    else if d8 then "s"
    else if d9 then "s"
    else if d10 then "s"
    else if d11 then "s"
    else if d12 then "s"
    else if d13 then "s"
    else if d14 then "s"
    else if d15 then "s"
    else if d16 then "s"
    else if d17 then "s"
    else if d18 then "s"
    else if d19 then "s"
    else ""
    end if
  end k

  def z = 1
end O

