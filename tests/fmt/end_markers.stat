<<< a marker after a comment stays, as the comment would leave the region
object A:
  def f =
    a
    b
    // last
  end f
>>>
object A:
  def f =
    a
    b
    // last
  end f

<<< a marker with a comment on its line stays
object A:
  def f =
    a
    b
  end f // why
>>>
object A:
  def f =
    a
    b
  end f // why

<<< a marker on a body of one expression stays, as scruff wouldn't add it
object A:
  def f =
    if c then
      a
    else b
  end f
  def g = 1
>>>
object A:
  def f =
    if c then a
    else b
  end f

  def g = 1

<<< a short else if chain loses the marker tree-sitter-scala puts on its last if
def f =
  val x = 1
  if a then b
  else if c then
    d
    e
  else g
  end if
  x
>>>
def f =
  val x = 1
  if a then b
  else if c then
    d
    e
  else g
  x

<<< a marker not at its statement's indentation stays
object A:
  def f =
    a
    b
    end f
  def g = 1
>>>
object A:
  def f =
    a
    b
    end f

  def g = 1

<<< the last inner statement's marker isn't its class's
