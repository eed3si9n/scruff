# Argument and parameter lists: on one line if they fit, otherwise one item
# per line with `)` on its own line, as in sbt's code. Arguments indent 2
# spaces and parameters 4, from the indentation of the line they start on.
maxColumn = 40

<<< a list that fits stays on one line
val x = f(alpha, beta, gamma)
>>>
val x = f(alpha, beta, gamma)

<<< arguments that don't fit go one per line
val x = compute(alpha, beta, gamma, delta, epsilon)
>>>
val x = compute(
  alpha,
  beta,
  gamma,
  delta,
  epsilon,
)

<<< a call that fits on the line after the `=` goes there whole
val x = compute(alpha, beta, gamma, delta)
def eval(expression: String): Result =
  eval(expression, noImports, srcName)
>>>
val x =
  compute(alpha, beta, gamma, delta)
def eval(expression: String): Result =
  eval(expression, noImports, srcName)

<<< a call that takes a lambda stays on the `=`'s line
val ys = xs.map(x => transform(x, alpha1))
>>>
val ys = xs.map(x =>
  transform(x, alpha1)
)

<<< parameters indent four spaces
def compute(alpha: Int, beta: Int): Int = 1
>>>
def compute(
    alpha: Int,
    beta: Int,
): Int = 1

<<< class parameters, with what follows after the closing parenthesis
case class Point(x: Int, y: Int) extends Shape
>>>
case class Point(
    x: Int,
    y: Int,
) extends Shape

<<< with several parameter lists, the last one that doesn't fit breaks
def run(alpha: Int)(using ctx: Context): Unit = ()
>>>
def run(alpha: Int)(
    using ctx: Context
): Unit = ()

<<< an inner list breaks only if it doesn't fit on its own line
val x = outer(inner(alpha, beta), gamma1, delta1)
val y = outer(inner(alpha, beta, gamma, delta, epsilon))
>>>
val x = outer(
  inner(alpha, beta),
  gamma1,
  delta1,
)
val y = outer(
  inner(
    alpha,
    beta,
    gamma,
    delta,
    epsilon,
  )
)

<<< indentation starts from the line the list is on
dialect = scala213
===
object A {
  def f = {
    compute(alpha, beta, gamma, delta, e)
  }
}
>>>
object A {
  def f = {
    compute(
      alpha,
      beta,
      gamma,
      delta,
      e,
    )
  }
}

<<< the rest of the line counts
val x = f(alpha, beta).andThenSomethingElse
>>>
val x = f(
  alpha,
  beta,
).andThenSomethingElse

<<< one argument breaks too, even if it still doesn't fit
log("a long message that never fits in 40")
>>>
log(
  "a long message that never fits in 40"
)

<<< an empty list stays
val result = someVeryLongFunctionName()
>>>
val result = someVeryLongFunctionName()

<<< a list written over several lines is joined if it fits
val x = compute(alpha,
    beta, gamma)
def f(
    a: Int,
    b: Int
) = a
>>>
val x = compute(alpha, beta, gamma)
def f(a: Int, b: Int) = a

<<< a list written over several lines that doesn't fit goes one per line, with a trailing comma
val result = someFunction(firstArgument, secondArgument,
  thirdArgument, fourthArgument, fifthArgument)
>>>
val result = someFunction(
  firstArgument,
  secondArgument,
  thirdArgument,
  fourthArgument,
  fifthArgument,
)

<<< the source's line breaks don't matter: these come out the same
val x = f(a, b,
  c)
val x = f(
  a,
  b,
  c
)
val x = f(a,
          b,
          c)
>>>
val x = f(a, b, c)
val x = f(a, b, c)
val x = f(a, b, c)

<<< a lambda alone in the arguments over several lines is joined
val z = foo(
  x => x + 1
)
>>>
val z = foo(x => x + 1)

<<< a for expression over several lines keeps the list as written
class A:
  given a: Arb[C] = Arb(
    for n <- Gen.alphaStr
    yield C(n)
  )
>>>
class A:
  given a: Arb[C] = Arb(
    for n <- Gen.alphaStr
    yield C(n)
  )

<<< a block after a list over several lines is indented from the line it ends up on
def test() =
  fn2(
      arg = "blue sleeps faster than tuesday",
      arg2 = "the quick brown fox jumped over the lazy dog"): env =>
      val x = env
      println(x)
>>>
def test() = fn2(
  arg = "blue sleeps faster than tuesday",
  arg2 = "the quick brown fox jumped over the lazy dog",
): env =>
  val x = env
  println(x)

<<< an item over several lines keeps the list as written
dialect = scala213
===
val x = f(a,
  g {
    b
    c
  })
>>>
val x = f(a,
  g {
    b
    c
  })

<<< a list with a comment stays as written
val x = compute(alpha, /* b */ beta, gamma)
>>>
val x =
  compute(alpha, /* b */ beta, gamma)

<<< a trailing comma in the source doesn't matter
val x = compute(
  alpha,
)
val y = compute(alpha, beta,
    gamma,
)
def f(
  a: Int,
  b: Int,
) = a
>>>
val x = compute(alpha)
val y = compute(alpha, beta, gamma)
def f(a: Int, b: Int) = a

<<< a trailing comma before `)` on its line, an error, stays as written
type T[X,] = X
>>>
type T[X,] = X

<<< inside a Scala 3 indentation region
def f =
  val x = compute(alpha, beta, gamma, delta, epsilon)
  x
>>>
def f =
  val x = compute(
    alpha,
    beta,
    gamma,
    delta,
    epsilon,
  )
  x

<<< a lambda alone in the arguments that fits stays on one line
val ys = xs.map(x => x + 1)
>>>
val ys = xs.map(x => x + 1)

<<< a lambda alone in the arguments breaks before its body
val ys = xs.map(x => compute(x, alpha, b))
>>>
val ys = xs.map(x =>
  compute(x, alpha, b)
)

<<< a lambda with parenthesized parameters
val total = xs.foldLeft(0)((acc, x) => acc + x)
>>>
val total = xs.foldLeft(0)((acc, x) =>
  acc + x
)

<<< a lambda after other arguments goes one per line with them
val ys = transform(xs, x => x + 1, ys, zs)
>>>
val ys = transform(
  xs,
  x => x + 1,
  ys,
  zs,
)

<<< a placeholder function is not a lambda
val ys = xs.map(_ + somethingVeryLong1234567890)
>>>
val ys = xs.map(
  _ + somethingVeryLong1234567890
)

<<< the body breaks further when it still doesn't fit
val ys = xs.map(x => compute(x, alpha, beta, gamma, delta, eps))
>>>
val ys = xs.map(x =>
  compute(
    x,
    alpha,
    beta,
    gamma,
    delta,
    eps,
  )
)

<<< a lambda in braces that fits stays on one line
dialect = scala213
===
val ys = xs.map { x => x + 1 }
>>>
val ys = xs.map { x => x + 1 }

<<< a lambda in braces breaks before its body
dialect = scala213
===
val ys = xs.map { x => compute(x, alpha, b) }
>>>
val ys = xs.map { x =>
  compute(x, alpha, b)
}

<<< a boolean body in braces moves as a whole first
dialect = scala213
===
val ys = xs.filter { x => x > lo && x < hi1 }
>>>
val ys = xs.filter { x =>
  x > lo && x < hi1
}

<<< a body ending in a call, which keeps one space before the brace when flat
dialect = scala213
===
val ys = xs.map { x => f(x, alpha, beta, gamma, delta) }
val zs = xs.map { x => f(x) }
>>>
val ys = xs.map { x =>
  f(x, alpha, beta, gamma, delta)
}
val zs = xs.map { x => f(x) }

<<< case clauses are left alone; a block holding one expression breaks the same way
dialect = scala213
===
val ys = xs.map { case (k, v) => k + v + other }
val y = g { compute(alpha, beta, gamma, delta1) }
>>>
val ys =
  xs.map { case (k, v) => k + v + other }
val y = g {
  compute(alpha, beta, gamma, delta1)
}

<<< nested lambdas in braces: the outer one breaks first
dialect = scala213
===
val a = reify { reify { x } }
val ys = xs.flatMap { x => ys.map { y => combine(x, y) } }
>>>
val a = reify { reify { x } }
val ys = xs.flatMap { x =>
  ys.map { y => combine(x, y) }
}

<<< a block argument over several lines is laid out from its parts
dialect = scala213
===
val y = g {
  f(x)
}
val zs = xs.map { x =>
  f(x)
}
val ws = xs.map { x => compute(alpha, beta) }
val vs = xs.flatMap { x =>
  ys.map { y =>
    combine(x, y)
  }
}
>>>
val y = g { f(x) }
val zs = xs.map { x => f(x) }
val ws = xs.map { x =>
  compute(alpha, beta)
}
val vs = xs.flatMap { x =>
  ys.map { y => combine(x, y) }
}

<<< other blocks over several lines keep their breaks
dialect = scala213
===
def f = {
  g(1)
}
val a = if (c) {
  b
} else {
  d
}
val ys = xs.map {
  x => f(x)
}
val zs = xs.map { x =>
  val y = f(x)
  y
}
val ws = xs.map { x =>
  import y._
}
>>>
def f = {
  g(1)
}
val a = if (c) {
  b
} else {
  d
}
val ys = xs.map {
  x => f(x)
}
val zs = xs.map { x =>
  val y = f(x)
  y
}
val ws = xs.map { x =>
  import y._
}

<<< type parameters that don't fit, when the value parameters fit
def sequential[Alpha, Beta, Gamma, Delta]: Unit = ()
>>>
def sequential[
    Alpha,
    Beta,
    Gamma,
    Delta,
]: Unit = ()

<<< type parameters fit; the value parameters after them break
def sequential[Alpha, Beta, Gamma](a: Alpha) = a
>>>
def sequential[Alpha, Beta, Gamma](
    a: Alpha
) = a

<<< parameters break before the type arguments of a result type
def f(alpha: Int)(beta: Int): (F[A], F[B]) = 1
>>>
def f(alpha: Int)(
    beta: Int
): (F[A], F[B]) = 1

<<< type arguments that don't fit
val m: Map[ModuleIdentifier, VersionNumber] = x
>>>
val m: Map[
  ModuleIdentifier,
  VersionNumber,
] = x

<<< type parameters with variance and bounds
class Cache[+Key <: Ordered[Key], Value, Third]
>>>
class Cache[
    +Key <: Ordered[Key],
    Value,
    Third,
]
