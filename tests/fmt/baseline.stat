<<< scala 2 code is unchanged
dialect = scala213
===
package a.b

import x.{ y, z }

/** Docs.
 *  More.
 */
class A(x: Int) extends B {
  def f(y: Int) = x + y // add

  /* block */ val z = List(1, 2)
}
>>>
package a.b

import x.{ y, z }

/** Docs.
 *  More.
 */
class A(x: Int) extends B {
  def f(y: Int) = x + y // add

  /* block */ val z = List(1, 2)
}

<<< scala 3 code is unchanged
enum Color:
  case Red, Green

object Main:
  def show(c: Color): String = c match
    case Color.Red => "red"
    case _         => "other"
  end show
>>>
enum Color:
  case Red, Green

object Main:
  def show(c: Color): String = c match
    case Color.Red => "red"
    case _         => "other"
  end show

<<< spacing within a line is normalized, indentation is kept
maxColumn = 20
===
object A {
	def f =   1   // tab and extra spaces
}
>>>
object A {
	def f = 1 // tab and extra spaces
}

<<< format off and on
val a = 1
// format: off
val b  =  List(1,2,   3)
// format: on
val c = 3
>>>
val a = 1
// format: off
val b  =  List(1,2,   3)
// format: on
val c = 3

<<< xml literal
