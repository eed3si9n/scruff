<<< for with enumerators on their own lines
object A:
  def short = for
    x <- xs
    y <- ys
  yield x + y
  def longWithALongerHeader(x: Any): Int = for
    x <- xs
    y <- ys
  yield x + y
  def next =
    for
      x <- xs
      y <- ys
    yield x + y
>>>
object A:
  def short =
    for
      x <- xs
      y <- ys
    yield x + y

  def longWithALongerHeader(x: Any): Int =
    for
      x <- xs
      y <- ys
    yield x + y

  def next =
    for
      x <- xs
      y <- ys
    yield x + y

