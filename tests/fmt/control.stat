# A definition's body that is a control structure over several lines
# starts the line after its `=`, a level deeper. A `match` stays on the
# `=`'s line if it starts within 30 columns of the line's indentation and
# its first line fits, however it's written, unless its cases sit at its
# own width. Calls and selects, as `Def.task { ... }`, stay where they are.

<<< match
object A:
  def short = x match
    case 1 => a
    case _ => b
  def longWithALongerHeader(x: Any): Int = x match
    case 1 => a
    case _ => b
  def next =
    x match
      case 1 => a
      case _ => b
>>>
object A:
  def short = x match
    case 1 => a
    case _ => b

  def longWithALongerHeader(x: Any): Int =
    x match
      case 1 => a
      case _ => b

  def next = x match
    case 1 => a
    case _ => b

<<< if
object A:
  def short = if c then
    a()
    b()
  else
    d()
    e()
  def longWithALongerHeader(x: Any): Int = if c then
    a()
    b()
  else
    d()
    e()
  def next =
    if c then
      a()
      b()
    else
      d()
      e()
>>>
object A:
  def short =
    if c then
      a()
      b()
    else
      d()
      e()

  def longWithALongerHeader(x: Any): Int =
    if c then
      a()
      b()
    else
      d()
      e()

  def next =
    if c then
      a()
      b()
    else
      d()
      e()
end A

<<< a try inside a try's body keeps its line, as it would take the catch
def f =
  try
    try { a } catch { case _: E => b }
  catch
    case _: F => c
>>>
def f =
  try
    try { a } catch { case _: E => b }
  catch case _: F => c

<<< try with catch and finally
object A:
  def short = try
    a()
    b()
  catch
    case e: IOException => c
    case e: Exception   => d
  finally e()
  def longWithALongerHeader(x: Any): Int = try
    a()
    b()
  catch
    case e: IOException => c
    case e: Exception   => d
  finally e()
  def next =
    try
      a()
      b()
    catch
      case e: IOException => c
      case e: Exception   => d
    finally e()
>>>
object A:
  def short =
    try
      a()
      b()
    catch
      case e: IOException => c
      case e: Exception   => d
    finally e()

  def longWithALongerHeader(x: Any): Int =
    try
      a()
      b()
    catch
      case e: IOException => c
      case e: Exception   => d
    finally e()

  def next =
    try
      a()
      b()
    catch
      case e: IOException => c
      case e: Exception   => d
    finally e()
end A

