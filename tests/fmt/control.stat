<<< a control structure after a long header starts the next line
object A:
  def discoverMainClasses(analysis: CompileAnalysis): Seq[String] = analysis match
    case a: Analysis => a.mainClasses
  private def definesMacro(analysis: CompileAnalysis): Boolean = if analysis.ok then
    a()
    b()
  else c
  def withCleanup(resource: Resource): Unit = try
    a()
    b()
  finally c()
  def collectEverything(xs: List[Int]): List[Int] = for x <- xs yield
    val y = x + 1
    y
>>>
object A:
  def discoverMainClasses(analysis: CompileAnalysis): Seq[String] =
    analysis match
      case a: Analysis => a.mainClasses

  private def definesMacro(analysis: CompileAnalysis): Boolean =
    if analysis.ok then
      a()
      b()
    else c

  def withCleanup(resource: Resource): Unit =
    try
      a()
      b()
    finally c()

  def collectEverything(xs: List[Int]): List[Int] =
    for x <- xs yield
      val y = x + 1
      y
end A

<<< a match starting within 30 columns joins the `=`'s line, however it's written
object A:
  def f(x: Any): Int =
    x match
      case 1 => 2
      case _ => 3
  val cross =
    id.crossVersionedValue match
      case CrossValue.Full => full
  def g(
      x: Int
  ): Int =
    x match
      case 1 => 2
>>>
object A:
  def f(x: Any): Int = x match
    case 1 => 2
    case _ => 3

  val cross = id.crossVersionedValue match
    case CrossValue.Full => full

  def g(x: Int): Int = x match
    case 1 => 2

<<< a `for` over several lines always starts the next line
object A:
  def f = for x <- xs yield
    val y = x + 1
    y
  def g =
    for
      x <- xs
      y <- ys
    yield x + y
  def h = for x <- xs yield x
>>>
object A:
  def f =
    for x <- xs yield
      val y = x + 1
      y

  def g =
    for
      x <- xs
      y <- ys
    yield x + y

  def h = for x <- xs yield x

<<< a match with cases at its own width stays on the next line
object A:
  def k(x: Int) =
    x match
    case 1 => one
>>>
object A:
  def k(x: Int) =
    x match
    case 1 => one

<<< the 30 columns count from the line's indentation
object A:
  object B:
    object C:
      def lookup(key: Int): A = key match
        case 1 => a
>>>
object A:
  object B:
    object C:
      def lookup(key: Int): A = key match
        case 1 => a

<<< one whose first line wouldn't fit starts the next line
maxColumn = 40
===
def f = someLongScrutinee.compute(alpha) match
  case 1 => 2
>>>
def f =
  someLongScrutinee.compute(alpha) match
    case 1 => 2

<<< calls, selects, blocks and one-line bodies stay on the `=`'s line
object A:
  def f(x: Any) = x match { case 1 => 2 }
  val t = Def.task {
    val y = 1
    y
  }
  val ys = xs.map { x =>
    val y = x + 1
    y
  }
  val h = (x: Int) => {
    a(x)
    b(x)
  }
  def g = if c then a else b
  def k = // the reason
    x match
      case _ => 1
>>>
object A:
  def f(x: Any) = x match { case 1 => 2 }

  val t = Def.task:
    val y = 1
    y

  val ys = xs.map: x =>
    val y = x + 1
    y

  val h = (x: Int) => {
    a(x)
    b(x)
  }

  def g = if c then a else b

  def k = // the reason
    x match
      case _ => 1
end A

<<< Scala 2: a match in braces moves with its cases
dialect = scala213
===
object A {
  def discoverMainClasses(analysis: CompileAnalysis): Seq[String] = analysis match {
    case 1 => 2
  }
  def f(x: Any) =
    x match {
      case 1 => 2
    }
}
>>>
object A {
  def discoverMainClasses(analysis: CompileAnalysis): Seq[String] =
    analysis match {
      case 1 => 2
    }

  def f(x: Any) = x match {
    case 1 => 2
  }
}
