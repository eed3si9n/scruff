# Comments inside a node, between the pieces a structural rule builds from.
# Each comment stays attached to the same token, with one space between it
# and code on the same line.

<<< between a keyword and a name
def  /* a */  f = 1
>>>
def /* a */ f = 1

<<< before the equals sign
def f  /* a */ = 1
val x: Int  /* b */ = 2
>>>
def f /* a */ = 1
val x: Int /* b */ = 2

<<< between modifiers
private  /* a */  final val x = 1
>>>
private /* a */ final val x = 1

<<< between an annotation and a definition
@inline  /* hot */  def f = 1
>>>
@inline /* hot */ def f = 1

<<< after an opening and before a closing parenthesis
val x = f(  /* a */ y /* b */  )
>>>
val x = f( /* a */ y /* b */ )

<<< after each parameter
def f(
    a: Int,   // first
    b: Int // second
) = a
>>>
def f(
    a: Int, // first
    b: Int // second
) = a

<<< on their own lines between parameters
def f(
    // first
    a: Int,
    /* second */
    b: Int
) = a
>>>
def f(
    // first
    a: Int,
    /* second */
    b: Int
) = a

<<< in type parameter and argument lists
def f[ /* t */ A](a: A): Map[ /* k */ String,  /* v */ Int] = Map()
>>>
def f[ /* t */ A](a: A): Map[ /* k */ String, /* v */ Int] = Map()

<<< after extends and with
class A extends  /* a */ B with  /* b */  C
>>>
class A extends /* a */ B, /* b */ C

<<< after an operator, ending the line
val x = a +  // why
  b
>>>
val x = a + // why
  b

<<< before a dot in a chain
val ys = xs
  // keep evens
  .filter(_ % 2 == 0) // done
  .map(_ + 1)
>>>
val ys = xs
  // keep evens
  .filter(_ % 2 == 0) // done
  .map(_ + 1)

<<< in an if expression
val x = if (a)  /* yes */ b else  /* no */  c
>>>
val x = if a then /* yes */ b else /* no */ c

<<< after an opening brace and before a closing one
dialect = scala213
===
object A {  // note
  val x = 1
  // last
}
>>>
object A { // note
  val x = 1
  // last
}

<<< in a case clause
dialect = scala213
===
val y = x match {
  case 1  /* one */ => a // first
  case _ =>  /* other */  b
}
>>>
val y = x match {
  case 1 /* one */ => a // first
  case _           => /* other */ b
}

<<< before a lambda arrow
val ys = xs.map { x  /* each */  => x }
>>>
val ys = xs.map { x /* each */ => x }

<<< in an indentation region
def f =
  // one
  1  // done
>>>
def f =
  // one
  1 // done

<<< a doc comment before a definition gets Scala 3's gutter
dialect = scala213
===
object A {
  /** Spam and eggs.
    *
    * @param a  the input
    */
  def f(a: Int) = a
}
>>>
object A {
  /** Spam and eggs.
   *
   *  @param a  the input
   */
  def f(a: Int) = a
}

<<< Scaladoc in Scala 3's style stays as written
/** The type `[tparams := paramRefs] tp`, where `tparams` can be
 *  either a list of type parameter symbols or a list of lambda parameters
 *
 *  @pre If `tparams` is a list of lambda parameters, then it must be the
 *       full, in-order list of type parameters of some type constructor, as
 *       can be obtained using `TypeApplications#typeParams`.
 */
def f = 1
>>>
/** The type `[tparams := paramRefs] tp`, where `tparams` can be
 *  either a list of type parameter symbols or a list of lambda parameters
 *
 *  @pre If `tparams` is a list of lambda parameters, then it must be the
 *       full, in-order list of type parameters of some type constructor, as
 *       can be obtained using `TypeApplications#typeParams`.
 */
def f = 1

<<< JavaDoc style Scaladoc: text moves up to the opening, two spaces after each star
/**
 * Spam and eggs.
 *
 * {{{
 *   f(1)
 * }}}
 */
def f(a: Int) = a
>>>
/** Spam and eggs.
 *
 *  {{{
 *    f(1)
 *  }}}
 */
def f(a: Int) = a

<<< a blank line after the opening stays below it
/**
 *
 * Spam and eggs.
 */
def f = 1
>>>
/**
 *
 *  Spam and eggs.
 */
def f = 1

<<< a Scaladoc with lines outside the gutter gets one
/** Spam and eggs.
  eggs
  {{{
    spam(eggs)
  }}}
  */
def f = 1
>>>
/** Spam and eggs.
 *  eggs
 *  {{{
 *    spam(eggs)
 *  }}}
 */
def f = 1

<<< a Scaladoc ending on a line of text stays as written
/** Spam and eggs.
  * Eggs. */
def f = 1
/** Spam.
def spam = {
  eggs
}*/
def g = 1
>>>
/** Spam and eggs.
  * Eggs. */
def f = 1
/** Spam.
def spam = {
  eggs
}*/
def g = 1

<<< a block comment is not a Scaladoc
/*
  * Spam.
  */
def f = 1
>>>
/*
  * Spam.
  */
def f = 1

<<< a Scaladoc after code stays as written
val a = 1 /** Spam
  * and eggs.
  */
>>>
val a = 1 /** Spam
  * and eggs.
  */

<<< a comment touching code gets a space on each side
@inline/* hot */def f = 1
def g /* a */= 1
class A extends B with/* b */C
val m: Map[String,/* v */Int] = Map()
val x = if (a) b else/* no */c
val y = f(/* a */x/* b */)
>>>
@inline /* hot */ def f = 1
def g /* a */ = 1


class A extends B, /* b */ C

val m: Map[String, /* v */ Int] = Map()
val x = if a then b else /* no */ c
val y = f( /* a */ x /* b */ )

<<< no space between a comment and a following comma, semicolon or colon
class A extends B /* b */ ,C, D
val y = f(a /* a */ ,b)
val z = 1 /* z */ ; val w = 2
trait T /* t */ :
  val x = 1
>>>
class A extends B /* b */, C, D

val y = f(a /* a */, b)
val z = 1 /* z */; val w = 2


trait T /* t */:
  val x = 1

<<< comments touching each other get a space between them
val x = 1/* a *//* b */
val y = f(a/* a *//* b */, b)
>>>
val x = 1 /* a */ /* b */
val y = f(a /* a */ /* b */, b)

<<< a comment starting a line moves with its statement and gets a space after it
dialect = scala213
===
object A {
    /* a */val x = 1
  val y = 2
}
object B {
  /* b */   /* c */  val y = 2
}
>>>
object A {
  /* a */ val x = 1
  val y = 2
}


object B {
  /* b */ /* c */ val y = 2
}

<<< comments in a format-off block stay as written
// format: off
val x = 1/* a */  /* b */
f(/* c */x)
// format: on
>>>
// format: off
val x = 1/* a */  /* b */
f(/* c */x)
// format: on

<<< a Scaladoc with one line of text goes on one line
/**
 * Spam and eggs.
 */
def f = 1
/** Eggs and spam.
  */
def g = 1
/** Spam.
 *
 */
def h = 1
>>>
/** Spam and eggs. */
def f = 1
/** Eggs and spam. */
def g = 1
/** Spam. */
def h = 1

<<< a Scaladoc with one line of text that doesn't fit on one line keeps its gutter
maxColumn = 25
===
/**
 * Spam, eggs, spam and spam.
 */
def f = 1
>>>
/** Spam, eggs, spam and spam.
 */
def f = 1
