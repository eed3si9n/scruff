  `extension`(1)
}


<<< enum case with type parameters (scala3/Enum.stat:287)
dialect = scala213
maxColumn = 80
===
enum Enum4 [ + T] {
  case G(s: String)
  case B extends Enum4[Int] with A
  case C [V] (s: String) extends Enum4[V]
  case D [T] (s: String) extends Enum4[T]
}
>>>
enum Enum4[+T] {
  case G(s: String)
  case B extends Enum4[Int] with A
  case C[V](s: String) extends Enum4[V]
  case D[T](s: String) extends Enum4[T]
}


