# Spacing between tokens on the same line.
#
# Cases whose titles end with a source file and line, like
# `(scala3/Vararg.stat:2)`, are copied from scalafmt (Apache-2.0), commit e1f0c2d,
# scalafmt-tests/shared/src/test/resources/, and use scalafmt's default width.
# Their expected outputs differ from the input only in spaces within lines.

<<< one space around operators and after commas
val x = f( a ,b )+g(c)*2
>>>
val x = f(a, b) + g(c) * 2

<<< braces get spaces inside, except when empty
object A{def f={}; def g ={x}}
>>>
object A { def f = {}; def g = { x } }

<<< one space around comments within a line
val x = a  /* why */  + b   // note
>>>
val x = a /* why */ + b // note

<<< strings keep their spaces
val s = f(  "a  b" ,  s"${ x }  y" )
>>>
val s = f("a  b", s"${ x }  y")

<<< line breaks and indentation are kept
def f(a:Int, b:Int) =
  a+
      b-
    c
>>>
def f(a: Int, b: Int) =
  a +
      b -
    c

<<< a name ending in an underscore keeps its space before an operator
val op_ : Int = 1
>>>
val op_ : Int = 1

<<< an operator name keeps its space before a colon
def + : Int = 1
>>>
def + : Int = 1

<<< a quoted wildcard keeps its space before a colon
def f(x: Expr[Any]) = x match
  case '{ $_ : Boolean } => 1
>>>
def f(x: Expr[Any]) = x match
  case '{ $_ : Boolean } => 1

<<< a space after unary minus is kept
def f = - 42
def g = -42
>>>
def f = - 42
def g = -42

<<< parameters after annotation arguments keep their space
class A @Inject()(b: C)
class B @Inject (b: C)
>>>
class A @Inject() (b: C)


class B @Inject (b: C)

<<< a keyword used as a name applies without a space
def extension (a: Int) = a
>>>
def extension(a: Int) = a

<<< a backticked name starting a line keeps its gap
dialect = scala213
===
object O {
  {
    `$`{e}
    `$`{e2}
  }
}
>>>
object O {
  {
    `$`{ e }
    `$`{ e2 }
  }
}

<<< format off is left alone
// format: off
val x = f( a ,b )
// format: on
val y = f( a ,b )
>>>
// format: off
val x = f( a ,b )
// format: on
val y = f(a, b)

