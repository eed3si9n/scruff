# Type wildcards as `?` and vararg splices as `xs*` where the dialect
# allows them. The dialect is Scala 3 unless a case names another.

<<< type arguments
def f(a: List[_], b: Map[_, Seq[_]]): Option[_] = None
>>>
def f(a: List[?], b: Map[?, Seq[?]]): Option[?] = None

<<< bounds
val a: Map[_ <: A, _ >: B <: C] = b
val c: List[_<:A] = d
>>>
val a: Map[? <: A, ? >: B <: C] = b
val c: List[? <: A] = d

<<< type patterns
x match {
  case _: List[_] => 1
}
>>>
x match
  case _: List[?] => 1

<<< type parameters keep `_`
def f[F[_]](x: F[Int]) = x
type G[_] = Int
>>>
def f[F[_]](x: F[Int]) = x
type G[_] = Int

<<< Scala 2 with -Xsource:3 has `?`
dialect = scala212source3
===
val a: List[_] = b
>>>
val a: List[?] = b

<<< plain Scala 2.13 keeps `_`, and `?` is a name there
dialect = scala213
===
val a: List[_] = b
val c: Functor[Either[A, ?]] = d
>>>
val a: List[_] = b
val c: Functor[Either[A, ?]] = d

<<< vararg splices
f(xs: _*)
g(a, h(b) : _ *)
x match {
  case Seq(a, xs @ _*) => 1
  case Seq(_*) => 2
}
>>>
f(xs*)
g(a, h(b)*)
x match
  case Seq(a, xs*) => 1
  case Seq(_*)     => 2

<<< vararg splices of an infix expression
f(a ++ b: _*)
g(files map { f =>
  f -> h(f)}: _*)
>>>
f(a ++ b*)
g(files map { f =>
  f -> h(f) }*)

<<< Scala 2 with -Xsource:3 splices an infix expression in parentheses
dialect = scala212source3
===
f(xs: _*)
f(a ++ b: _*)
f(!n: _*)
f(a ++ b_ : _*)
val importables0 = ListMap[From, Importable](files map { f =>
  f -> toImportable(ev.toURI(f), ev.toRawSchema(f))}: _*)
>>>
f(xs*)
f((a ++ b)*)
f(!n*)
f((a ++ b_)*)

val importables0 = ListMap[From, Importable]((files map { f =>
  f -> toImportable(ev.toURI(f), ev.toRawSchema(f)) })*)

<<< plain Scala 2.13 gets its vararg splices back
dialect = scala213
===
f(xs*)
x match {
  case Seq(a, xs*) => 1
}
>>>
f(xs: _*)
x match {
  case Seq(a, xs @ _*) => 1
}
