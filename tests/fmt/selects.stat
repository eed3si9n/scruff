# Select chains with at least two calls: on one line if they fit, otherwise
# broken before the first call's `.` and every `.` after it, each indented 2
# spaces, as scalafmt's classic select chains in sbt's code.
maxColumn = 40

<<< a chain that fits stays on one line
val ys = xs.map(f).filter(g)
>>>
val ys = xs.map(f).filter(g)

<<< a chain that doesn't fit breaks before each dot
val ys = xs.map(f).filter(good).take(n1).drop(2)
>>>
val ys = xs
  .map(f)
  .filter(good)
  .take(n1)
  .drop(2)

<<< field selects before the first call stay with the head
val v = sys.env.get(key).map(parse).getOrElse(d)
>>>
val v = sys.env
  .get(key)
  .map(parse)
  .getOrElse(d)

<<< field selects after the first call get lines of their own
val n = xs.map(f).filter(good).toList.length12
>>>
val n = xs
  .map(f)
  .filter(good)
  .toList
  .length12

<<< type arguments without a call stay with the head too
val ys = xs.asInstanceOf[List[Int]].map(f).filter(g)
>>>
val ys = xs.asInstanceOf[List[Int]]
  .map(f)
  .filter(g)

<<< a head that is a call keeps its arguments
val r = compute(alpha).map(f).filter(g123456789)
>>>
val r = compute(alpha)
  .map(f)
  .filter(g123456789)

<<< one call is not a chain; its arguments break instead
val ys = Generator.string(alpha, beta, gamma1, d)
>>>
val ys = Generator.string(
  alpha,
  beta,
  gamma1,
  d,
)

<<< a block argument in a chain
dialect = scala213
===
val ys = xs.map { x => x + 1 }.filter(good1)
>>>
val ys = xs
  .map { x => x + 1 }
  .filter(good1)

<<< one call and a field is not a chain either; a lambda breaks instead
val ys = xs.map(x => transform(x, alpha, beta, gamma)).toList
>>>
val ys = xs.map(x =>
  transform(x, alpha, beta, gamma)
).toList

<<< the dots break first, then a call that still doesn't fit
val ys = xs.map(x => transform(x, alpha, beta)).filter(ok)
val zs = xs.map(x => transform(x, alpha, beta, gamma1)).filter(ok)
>>>
val ys = xs
  .map(x => transform(x, alpha, beta))
  .filter(ok)

val zs = xs
  .map(x =>
    transform(x, alpha, beta, gamma1)
  )
  .filter(ok)

<<< a chain written over several lines is joined if it fits
val ys = xs.map(f)
  .filter(g).take(n)
val zs = sys
  .env
  .get(k)
  .map(f)
>>>
val ys = xs.map(f).filter(g).take(n)
val zs = sys.env.get(k).map(f)

<<< the source's line breaks don't matter: these come out the same
val ys = xs.map(transform).filter(good)
  .take(n1)
val ys = xs
  .map(transform).filter(good).take(n1)
val ys = xs.map(transform)
  .filter(good)
  .take(n1)
>>>
val ys = xs
  .map(transform)
  .filter(good)
  .take(n1)

val ys = xs
  .map(transform)
  .filter(good)
  .take(n1)

val ys = xs
  .map(transform)
  .filter(good)
  .take(n1)

<<< a chain with a part over several lines keeps its line breaks
dialect = scala213
===
val ys = xs
  .map { x =>
    val y = x + 1
    y * 2
  }
  .filter(g)
>>>
val ys = xs
  .map { x =>
    val y = x + 1
    y * 2
  }
  .filter(g)

<<< a chain with a comment keeps its line breaks
val ys = xs
  // evens
  .filter(even)
  .map(f)
>>>
val ys = xs
  // evens
  .filter(even)
  .map(f)

<<< a chain inside a list is joined with it
val x = f(
  xs
    .map(g)
    .filter(h),
  y,
)
>>>
val x = f(xs.map(g).filter(h), y)

<<< a chain's one call with a colon argument stays with the head
Test / resourceGenerators += Def
  .task:
    Seq(resource)
  .taskValue
val a = Def.task:
  Seq(resource)
.taskValue
val b = xs.collect:
  case Some(x) => x
.toList.size
>>>
Test / resourceGenerators += Def.task:
    Seq(resource)
  .taskValue

val a = Def.task:
    Seq(resource)
  .taskValue

val b = xs.collect:
    case Some(x) => x
  .toList
  .size

<<< a lambda's parameters stay with it
val a = xs.foreach: x =>
  println(x)
.size
val b = xs
  .foreach: (x, y) =>
    val z = x
    z
  .size
>>>
val a = xs.foreach: x =>
    println(x)
  .size

val b = xs.foreach: (x, y) =>
    val z = x
    z
  .size
