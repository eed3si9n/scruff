# Infix chains: on one line if they fit, otherwise broken before each
# operator, with the operators starting the lines after the first, indented
# 2 spaces from the line the chain starts on. In Scala 2, where a line can't
# start with an operator, the broken chain is wrapped in parentheses unless
# it's inside some already, as an `if` condition or an argument is. The
# source's line breaks next to the operators don't matter.
maxColumn = 40

<<< a chain that fits stays on one line
val ok = alpha && beta && gamma
>>>
val ok = alpha && beta && gamma

<<< a chain that doesn't fit breaks before each operator
val ok = alpha && beta && gamma && delta1
>>>
val ok = alpha
  && beta
  && gamma
  && delta1

<<< only the loosest operators break; tighter ones stay together
val ok = alpha == beta || gamma == delta1
>>>
val ok = alpha == beta
  || gamma == delta1

<<< && inside || stays together when it fits on its line
val ok = alpha && beta || gamma && delta && eps
>>>
val ok = alpha && beta
  || gamma && delta && eps

<<< other operators don't break, as in scalafmt with sbt's settings
val xs = alpha :: beta :: gamma :: delta :: Nil
val m = "org.example" % "artifact-name" % "1.0.0"
val s = "a" + alpha + "b" + beta + "c" + gamma1
>>>
val xs = alpha :: beta :: gamma :: delta :: Nil
val m = "org.example" % "artifact-name" % "1.0.0"
val s = "a" + alpha + "b" + beta + "c" + gamma1

<<< a boolean chain inside another expression breaks on its own
val n = count + (alpha && beta && gamma && delta)
>>>
val n = count + (alpha
  && beta
  && gamma
  && delta)

<<< a trailing comment doesn't count toward the width
val ok = alpha && beta // a long comment that goes on
>>>
val ok = alpha && beta // a long comment that goes on

<<< an alphanumeric operator doesn't break yet
val x = first getOrElse second getOrElse third1
>>>
val x = first getOrElse second getOrElse third1

<<< inside an argument list
assert(alpha && beta && gamma && delta && eps)
>>>
assert(
  alpha && beta && gamma && delta && eps
)

<<< indentation starts from the line the chain is on
dialect = scala213
===
object A {
  def ok = alpha && beta && gamma && delta
}
>>>
object A {
  def ok = (alpha
    && beta
    && gamma
    && delta)
}

<<< Scala 2: a chain that fits gets no parentheses
dialect = scala213
===
val ok = alpha && beta && gamma
>>>
val ok = alpha && beta && gamma

<<< Scala 2: the `)` goes before a trailing comment
dialect = scala213
===
val ok = alpha && beta && gamma && delta1 // why
>>>
val ok = (alpha
  && beta
  && gamma
  && delta1) // why

<<< Scala 2: an `if` condition has its parentheses already
dialect = scala213
===
if (alpha && beta && gamma && delta && eps1) f()
>>>
if (alpha
  && beta
  && gamma
  && delta
  && eps1) f()

<<< Scala 2: so does a chain inside an argument
dialect = scala213
===
foo(x, alpha && beta && gamma && delta && epsilon)
>>>
foo(
  x,
  alpha
    && beta
    && gamma
    && delta
    && epsilon,
)

<<< Scala 2: and one inside a lambda in parentheses
dialect = scala213
===
xs.filter(x => alpha && beta && gamma && delta && eps)
>>>
xs.filter(x =>
  alpha && beta && gamma && delta && eps
)

<<< Scala 2: a lambda in braces needs them again
dialect = scala213
===
xs.filter { x => alpha && beta && gamma && delta && epsilon }
>>>
xs.filter { x =>
  (alpha
    && beta
    && gamma
    && delta
    && epsilon)
}

<<< Scala 2: parentheses around a broken chain are its own
dialect = scala213
===
val ok = (alpha && beta && gamma && delta1)
>>>
val ok = (alpha
  && beta
  && gamma
  && delta1)

<<< Scala 2: so they go when it fits
dialect = scala213
===
val ok = (alpha
  && beta)
val no = (alpha &&
  beta)
>>>
val ok = alpha && beta
val no = alpha && beta

<<< Scala 3 needs no parentheses
val ok = (alpha && beta && gamma && delta1)
def f = (alpha && beta)
>>>
val ok = alpha
  && beta
  && gamma
  && delta1

def f = alpha && beta

<<< parentheses needed for grouping stay
dialect = scala213
===
val n = count + (alpha &&
  beta)
val m = (alpha && beta) || (gamma &&
  delta)
>>>
val n = count + (alpha && beta)

val m = ((alpha && beta)
  || (gamma && delta))

<<< Scala 2: an `if` condition in Scala 3's syntax, left as written, gets none
dialect = scala213
===
object A {
  def f =
    x match
      case _ =>
        if alpha || (beta && gamma && delta)
        then a
        else b
}
>>>
object A {
  def f = x match {
    case _ =>
      if alpha
        || (beta && gamma && delta)
      then a
      else b
  }
}

<<< a chain written over several lines is laid out as one written on one
val ok = alpha &&
    beta && gamma
val no = alpha
      && beta
      && gamma
val long = alpha &&
  beta && gamma && delta
>>>
val ok = alpha && beta && gamma
val no = alpha && beta && gamma

val long = alpha
  && beta
  && gamma
  && delta

<<< a block on the chain's last line is indented from the `if`
dialect = scala213
===
object A {
  if (alphaAlpha && betaBeta &&
      gammaGamma && deltaDelta) {
    body()
  }
}
>>>
object A {
  if (alphaAlpha
    && betaBeta
    && gammaGamma
    && deltaDelta) {
    body()
  }
}

<<< Scala 2: a lambda's body on its own line is still inside the parentheses
dialect = scala213
===
xs.filterNot(x => alphaAlpha && betaBeta && gammaGamma && x > 1)
>>>
xs.filterNot(x =>
  alphaAlpha
    && betaBeta
    && gammaGamma
    && x > 1
)

<<< kept as written where tree-sitter-scala reads the lines after it by its line breaks
maxColumn = 200
===
object A {
  def f = {
    pat match {
      case IdPattern(id, tpt) =>
            val (firstDef, splitRhs) = rhs match
              case TuplePattern(elems) if opt == SimpleTuple
                                       && variables.forall((n, _) => n != nme) =>
                for ((named, tpt), idx) <- variables if named.name != nme
                yield
                    valDef(
                  )
              flatTree(firstDef ++ restDefs)
    }
  }
}
>>>
object A:
  def f = pat match
    case IdPattern(id, tpt) =>
          val (firstDef, splitRhs) = rhs match
            case TuplePattern(elems) if opt == SimpleTuple
                                     && variables.forall((n, _) => n != nme) =>
              for ((named, tpt), idx) <- variables if named.name != nme
              yield
                valDef(
              )
            flatTree(firstDef ++ restDefs)

<<< a chain with a comment inside keeps its line breaks
val ok = alpha && // why
    beta && gamma
>>>
val ok = alpha && // why
    beta && gamma
