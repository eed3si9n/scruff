# Indentation: a container's statements sit 2 spaces deeper than the line
# that opens it, and every line inside moves by as much as its statement.

<<< braces get two spaces per level
dialect = scala213
===
object A {
    def f = {
            g(1)
    }
}
>>>
object A {
  def f = {
    g(1)
  }
}

<<< Scala 3 regions get two spaces per level
object A:
    def f =
          g(1)
>>>
object A:
  def f = g(1)

<<< continuation lines keep their shape
dialect = scala213
===
object A {
    val x = a +
        b +
          c
}
>>>
object A {
  val x = a +
      b +
        c
}

<<< a body is indented from the first line of its definition
dialect = scala213
===
class Cache[K, V](size: Int)
    extends Base
    with Logging {
      def get(k: K): V = ???
}
>>>
class Cache[K, V](size: Int)
    extends Base
    with Logging {
  def get(k: K): V = ???
}

<<< a lambda body is indented from the line with its arrow
dialect = scala213
===
object A {
  val ys = xs
    .map { x =>
          val y = x + 1
          y * 2
    }
}
>>>
object A {
  val ys = xs
    .map { x =>
      val y = x + 1
      y * 2
    }
}

<<< a typed lambda body in braces is indented from the line with its arrow
dialect = scala213
===
object A {
  val ys = xs
    .map { x: Int =>
          val y = x + 1
          y * 2
    }
}
>>>
object A {
  val ys = xs
    .map { x: Int =>
      val y = x + 1
      y * 2
    }
}

<<< nested typed lambdas in braces indent the body from the arrows' line
val h = { x: Int => y: Int =>
      val z = x + y
      z
}
>>>
val h = { x: Int => y: Int =>
  val z = x + y
  z
}

<<< a typed lambda body getting shallower is indented from its arrow
# From tree-sitter-scala's corpus (#705), which reads this since 0.26.5.
dialect = scala213
===
val f = _.next { x: M.N =>
    val a = 1
  val b = 2
}
>>>
val f = _.next { x: M.N =>
  val a = 1
  val b = 2
}

<<< statements in braces getting shallower move to one width, comments with them
dialect = scala213
===
def f = {
      val a = 1
    // b
    val b = 2
  b
}
>>>
def f = {
  val a = 1
  // b
  val b = 2
  b
}

<<< members in braces getting shallower move to one width
dialect = scala213
===
object A {
      def f = xs.map { x =>
          val y = x + 1
          y * 2
      }
  def g = 1
}
>>>
object A {
  def f = xs.map { x =>
    val y = x + 1
    y * 2
  }

  def g = 1
}

<<< a statement deeper than the one before it keeps the layout in braces
dialect = scala213
===
def f = {
    a
      b
}
>>>
def f = {
    a
      b
}

<<< cases are indented from the start of their match
object A:
  def f(c: Boolean) =
    (if c then a
     else b) match
        case 1 => one
        case _ => other
>>>
object A:
  def f(c: Boolean) = (if c then a
   else b) match
    case 1 => one
    case _ => other

<<< cases written at the width of their match stay there
object A:
  def f(x: Int) =
    x match
    case 1 => one
    case _ => other
>>>
object A:
  def f(x: Int) =
    x match
    case 1 => one
    case _ => other

<<< a Scaladoc moves with its definition
dialect = scala213
===
object A {
    /** Spam and eggs.
      *
      * @param a the input
      */
    def f(a: Int) = a
}
>>>
object A {
  /** Spam and eggs.
   *
   *  @param a the input
   */
  def f(a: Int) = a
}

<<< comments at column 0 move in with the code
dialect = scala213
===
object A {
// note
    def f = 1
}
>>>
object A {
  // note
  def f = 1
}

<<< a block whose statements disagree moves with the block around it
dialect = scala213
===
object A {
    def f = {
        a
          b
    }
}
>>>
object A {
  def f = {
      a
        b
  }
}

<<< strings keep their lines
dialect = scala213
===
object A {
    val s = """
      |text
      |""".stripMargin
}
>>>
object A {
  val s = """
      |text
      |""".stripMargin
}

<<< a body stays indented from its `if` when a rule breaks the condition
def f =
  if alpha && beta && gamma && delta && epsilon && zeta && eta && theta && iota && kappa && lambda then
    one()
    two
  else
    three()
    four
>>>
def f =
  if alpha
    && beta
    && gamma
    && delta
    && epsilon
    && zeta
    && eta
    && theta
    && iota
    && kappa
    && lambda then
    one()
    two
  else
    three()
    four

<<< a block follows its `{` to the line a joined list ends on
dialect = scala213
===
def f =
  run(
    alpha,
    beta
  ).map { x =>
        val y = x + 1
        y * 2
  }
>>>
def f = run(alpha, beta).map { x =>
  val y = x + 1
  y * 2
}

<<< a body after a broken condition is placed from the condition's line
dialect = scala213
===
object A {
  def f = x match {
    case ref =>
      if (currentOwner.enclosingMethodOrClassOrObject.isProperlyContainedIn(refSym.enclosingMethodOrClassOrObject.fooooo))
        report.error(em"Separation failure: a description of the failure, sized to fit on its", pos)
  }
}
>>>
object A {
  def f = x match {
    case ref =>
      if (currentOwner.enclosingMethodOrClassOrObject.isProperlyContainedIn(
        refSym.enclosingMethodOrClassOrObject.fooooo
      ))
        report.error(em"Separation failure: a description of the failure, sized to fit on its", pos)
  }
}

<<< statements at the opener's indentation move in
object A {
def foo: Int = 1
}
>>>
object A:
  def foo: Int = 1

<<< nested statements at the opener's indentation move in
object A {
def foo = {
bar
}
}
>>>
object A:
  def foo =
    bar

<<< statements shallower than the opener's line move in
object A {
  object B {
def foo: Int = 1
  }
}
>>>
object A:
  object B:
    def foo: Int = 1
