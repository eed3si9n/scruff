# Braces become indentation where Scala 3 allows it.

<<< class, object and definition bodies
object A {
  class B extends C {
    def f = {
      val x = 1
      x
    }
  }
}
>>>
object A:
  class B extends C:
    def f =
      val x = 1
      x

<<< a symbolic name gets backticks, and a private constructor an empty clause
object #:: {
  val x = 1
}
class A private {
  val x = 1
}
object foo_+ {
  val x = 1
}
>>>
object `#::`:
  val x = 1


class A private ():
  val x = 1


object foo_+ {
  val x = 1
}

<<< match and case bodies
def f(x: Int) = x match {
  case 1 => {
    a()
    b()
  }
  case _ => c
}
>>>
def f(x: Int) = x match
  case 1 =>
    a()
    b()
  case _ => c

<<< if, else, try, catch, finally
def f =
  if (c) {
    a
  } else {
    b
  }
def g =
  try {
    a
  } catch {
    case e: Exception => b
  } finally {
    c
  }
>>>
def f =
  if c then a
  else b

def g =
  try a
  catch case e: Exception => b
  finally c

<<< a catch with more than one case keeps them on their own lines
def g =
  try {
    a
  } catch {
    case e: IOException => b
    case e: Exception => c
  }
>>>
def g =
  try a
  catch
    case e: IOException => b
    case e: Exception   => c

<<< a catch's one case joins its line, also with its body in braces
def g =
  try a
  catch
    case e: Exception => { b }
  finally c
>>>
def g =
  try a
  catch case e: Exception => { b }
  finally c

<<< a catch's case with a `;` keeps its own line
def g =
  try a
  catch
    case e: Exception => log(e); b
  finally c
>>>
def g =
  try a
  catch
    case e: Exception => log(e); b
  finally c

<<< Scala 2 gets braces around a catch's case on its line
dialect = scala213
===
def g =
  try a
  catch case e: Exception => b
  finally c
>>>
def g =
  try a
  catch { case e: Exception => b }
  finally c

<<< Scala 2 gets braces around a catch's case over several lines
dialect = scala213
===
def g =
  try a
  catch case e: Exception =>
    log(e)
    b
>>>
def g =
  try a
  catch { case e: Exception =>
    log(e)
    b
  }

<<< for braces
for {
  x <- xs
  y <- ys
} yield x + y
>>>
for
  x <- xs
  y <- ys
yield x + y

<<< comments stay with their lines
class A { // a note
  val x = 1
  // the end
}
val y = 2
>>>
class A: // a note
  val x = 1
  // the end

val y = 2

<<< braces stay where Scala 3 needs them or the layout is in doubt
def f = { a }
val g = {
  a
}.map(h)
new A {
  val x = 1
}
>>>
def f = { a }

val g = {
  a
}.map(h)

new A {
  val x = 1
}

<<< Scala 2 keeps its braces
dialect = scala213source3
===
object A {
  val x = 1
}
>>>
object A {
  val x = 1
}

<<< plain Scala 2.13 gets braces back
dialect = scala213
===
object A:
  def f =
    val x = 1
    x // the result
  def g =
    try
      a
      b
    catch
      case e: Exception => c
    finally
      d
  def h(x: Int) = x match
    case 1 => "one"
    case _ => "many"
>>>
object A {
  def f = {
    val x = 1
    x // the result
  }

  def g =
    try {
      a
      b
    } catch {
      case e: Exception => c
    } finally d

  def h(x: Int) = x match {
    case 1 => "one"
    case _ => "many"
  }
}
