# Braced arguments become colon arguments, as SIP-44 allows in Scala 3.

<<< lambdas, blocks and cases
val a = xs.map { x =>
  val y = x + 1
  y * 2
}
val b = xs.map { (x, y) =>
  x + y
}
xs.foreach {
  println("a")
  println("b")
}
val c = xs.collect {
  case Some(x) => x
}
>>>
val a = xs.map: x =>
  val y = x + 1
  y * 2
val b = xs.map: (x, y) =>
  x + y
xs.foreach:
  println("a")
  println("b")
val c = xs.collect:
  case Some(x) => x

<<< a typed parameter gets the parentheses a colon argument needs
val a = xs.map { x: Int =>
  val y = x + 1
  y * 2
}
val b = xs.map { x: Int => x + 1 }
// From tree-sitter-scala's corpus (#705).
val f = _.next { x: M.N =>
    val a = 1
  val b = 2
}
>>>
val a = xs.map: (x: Int) =>
  val y = x + 1
  y * 2
val b = xs.map: (x: Int) =>
  x + 1
// From tree-sitter-scala's corpus (#705).
val f = _.next: (x: M.N) =>
  val a = 1
  val b = 2

<<< in a chain, and after other arguments
val a = xs
  .filter(p)
  .map { x =>
    x + 1
  }
foo(a) { x =>
  x
}
>>>
val a = xs
  .filter(p)
  .map: x =>
    x + 1
foo(a): x =>
  x

<<< on one line, before a selection, or inside parentheses
val a = xs.map { x => x + 1 }
val b = xs.map { x =>
  x + 1
}.filter(p)
f(xs.map { x =>
  x + 1
})
>>>
val a = xs.map: x =>
  x + 1
val b = xs
  .map: x =>
    x + 1
  .filter(p)
f(xs.map: x =>
  x + 1
)

<<< a colon argument with more of the chain after it breaks the chain
val a = xs.filter(p).map { x =>
  x + 1
}.sum
val b = xs.foreach:
  println(x)
.size
>>>
val a = xs
  .filter(p)
  .map: x =>
    x + 1
  .sum
val b = xs.foreach:
    println(x)
  .size

<<< cases on one line in a chain (cats instances/map.scala)
trait MapInstances {
  implicit def catsStdShowForMap[A, B](implicit showA: Show[A], showB: Show[B]): Show[Map[A, B]] =
    _.iterator
      .map { case (a, b) => showA.show(a) + " -> " + showB.show(b) }
      .mkString("Map(", ", ", ")")
}
>>>
trait MapInstances:
  implicit def catsStdShowForMap[A, B](using showA: Show[A], showB: Show[B]): Show[Map[A, B]] =
    _.iterator
      .map:
        case (a, b) => showA.show(a) + " -> " + showB.show(b)
      .mkString("Map(", ", ", ")")

<<< statements after a semicolon in a chain (cats EvalSuite.scala)
class EvalSuite {
  test("memoize handles branched evaluation correctly") {
    forAll { (e: Eval[Int], fn: Int => Eval[Int]) =>
      var n0 = 0
      val a0 = e.flatMap { i =>
        n0 += 1; fn(i);
      }.memoize
      assert(n0 == 1)
    }
  }
}
>>>
class EvalSuite:
  test("memoize handles branched evaluation correctly"):
    forAll: (e: Eval[Int], fn: Int => Eval[Int]) =>
      var n0 = 0
      val a0 = e.flatMap: i =>
          n0 += 1; fn(i);
        .memoize
      assert(n0 == 1)

<<< braces stay before other code
val a = xs.map { x => x + 1 } ++ ys
val b = xs.map { x =>
  val y = x + 1
  y * 2
} ++ ys
>>>
val a = xs.map { x => x + 1 } ++ ys
val b = xs.map { x =>
  val y = x + 1
  y * 2
} ++ ys

<<< Scala 2 gets braces back
dialect = scala213
===
val a = xs.map: x =>
  val y = x + 1
  y * 2
fn2(
    arg = "blue sleeps faster than tuesday",
    arg2 = "the quick brown fox jumped over the lazy dog"): env =>
  println(env)
>>>
val a = xs.map { x =>
  val y = x + 1
  y * 2
}
fn2(
  arg = "blue sleeps faster than tuesday",
  arg2 = "the quick brown fox jumped over the lazy dog",
) { env => println(env) }

<<< Scala 2 keeps a typed wildcard parameter (#16)
dialect = scala213
===
f { _: Int =>
  "x"
}
forAll { _: IntMarshallingExample =>
    "intUnmarshaller.unmarshalNoError(marshalledValue)" shouldNot compile
}
>>>
f { _: Int => "x" }
forAll { _: IntMarshallingExample =>
  "intUnmarshaller.unmarshalNoError(marshalledValue)" shouldNot compile
}

<<< Scala 2 gets braces back before a selection or a closing parenthesis
dialect = scala213
===
val b = xs.map: x =>
  x + 1
.filter(p)
f(xs.map: x =>
  x + 1
)
>>>
val b = xs.map { x => x + 1 }.filter(p)
f(xs.map { x => x + 1 })
